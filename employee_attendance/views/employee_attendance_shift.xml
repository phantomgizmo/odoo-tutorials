<odoo>
    <record id="view_shift_tree" model="ir.ui.view">
        <field name="name">Shift Tree</field>
        <field name="model">hr.shift</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="200"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="grace_period"/>
            </list>
        </field>
    </record>

    <record id="employee_attendance_shift_action" model="ir.actions.act_window">
        <field name="name">Shift</field>
        <field name="res_model">hr.shift</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_shift_tree" />
    </record>
</odoo>