<odoo>
    <record id="employee_attendance_view_form" model="ir.ui.view">
        <field name="name">employee_attendance.attendance</field>
        <field name="model">employee.attendance</field>
        <field name="arch" type="xml">
            <form string="Employee attendances" duplicate="false">
                <sheet>
                    <group>
                        <field name="employee_id" widget="many2one_avatar_user"/>
                        <field name="shift_id" />
                        <button name="check_in_action" type="object" class="btn-primary" invisible="check_in_status">Check in</button>
                        <button name="check_out_action" type="object" class="btn-primary" invisible="check_out or not check_in_status">Check out</button>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_attendance_tree" model="ir.ui.view">
        <field name="name">Attendance Tree</field>
        <field name="model">employee.attendance</field>
        <field name="arch" type="xml">
            <list js_class="attendance_list_view">
                <field name="employee_id"/>
                <field name="check_in" width="200"/>
                <field name="check_out" width="200"/>
                <field name="shift_id" width="200"/>
                <field name="late_minutes" width="200"/>
                <field name="overtime_hours" width="200"/>
            </list>
        </field>
    </record>

    <record id="employee_attendance_view_filter" model="ir.ui.view">
        <field name="name">employee_attendance_view_filter</field>
        <field name="model">employee.attendance</field>
        <field name="arch" type="xml">
            <search string="Employee Attendance Search">
                <filter string="Date" name="groupby_name" context="{'group_by': 'check_in:month'}"/>
            </search>
        </field>
    </record>

    <record id="employee_attendance_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">employee.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_attendance_tree" />
        <field name="search_view_id" ref="employee_attendance_view_filter" />
    </record>
</odoo>